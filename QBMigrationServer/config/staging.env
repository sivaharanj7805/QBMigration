# ============================================================================
# QB MIGRATION SERVER - STAGING ENVIRONMENT CONFIGURATION
# ============================================================================
# ForensicBridge Platform - Staging Environment
# Region: ca-central-1 (Canadian Data Residency - PIPEDA/CRA Compliance)
#
# This file configures the staging environment which mirrors production
# with slightly relaxed rate limits for QA and integration testing.
#
# SECURITY: Do NOT commit secrets to this file in version control.
#           Use AWS Secrets Manager for all credential values.
#           Placeholder values below must be replaced via CI/CD pipeline
#           or Secrets Manager injection at deploy time.
# ============================================================================

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
# FIX: 'staging' is not a recognized Flask config key; use 'production' with
# a custom APP_ENV for staging-specific behavior
FLASK_ENV=production
APP_ENV=staging

# CFG-02: Debug disabled in all non-development environments
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Inject from AWS Secrets Manager: forensicbridge/staging/flask-secret
SECRET_KEY=INJECT-FROM-SECRETS-MANAGER

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Inject from AWS Secrets Manager: forensicbridge/staging/webhook-secret
WEBHOOK_SECRET=INJECT-FROM-SECRETS-MANAGER

# Staging server URL (behind ALB)
SERVER_URL=https://staging-api.forensicbridge.ca

# CORS: Staging dashboard origin
# Both www and non-www variants are automatically added
ALLOWED_ORIGINS=https://staging.forensicbridge.ca,https://staging-api.forensicbridge.ca

# Backup encryption key
# Inject from AWS Secrets Manager: forensicbridge/staging/backup-encryption-key
BACKUP_ENCRYPTION_KEY=INJECT-FROM-SECRETS-MANAGER

# ============================================================================
# DATABASE - PostgreSQL (RDS Staging)
# ============================================================================
# Staging RDS instance in ca-central-1 (Multi-AZ for parity with production)
# Inject from AWS Secrets Manager: forensicbridge/staging/database
DATABASE_URL=postgresql://fbadmin_staging:INJECT-FROM-SECRETS-MANAGER@forensicbridge-staging.xxxxx.ca-central-1.rds.amazonaws.com:5432/forensicbridge_staging

# ============================================================================
# AWS CONFIGURATION
# ============================================================================
# IMPORTANT: Use IAM roles (instance profiles) instead of access keys.
# Access keys below are fallback only; prefer ECS task role authentication.
AWS_ACCESS_KEY_ID=INJECT-FROM-SECRETS-MANAGER
AWS_SECRET_ACCESS_KEY=INJECT-FROM-SECRETS-MANAGER

# M-20 FIX: ca-central-1 for PIPEDA/Canadian data residency compliance
AWS_REGION=ca-central-1

# S3 Bucket - staging-specific bucket with same encryption/versioning as prod
AWS_S3_BUCKET=forensicbridge-archives-staging

# EC2 Configuration (for migration worker instances)
AWS_EC2_AMI_ID=ami-xxxxxxxxxxxxxxxxx
AWS_EC2_INSTANCE_TYPE=t3.medium
AWS_EC2_KEY_NAME=forensicbridge-staging-keypair
AWS_EC2_SECURITY_GROUP=sg-xxxxxxxxxxxxxxxxx
AWS_EC2_SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx

# IAM Role for EC2 migration worker instances
AWS_IAM_INSTANCE_PROFILE=QB-Migration-Staging-Instance-Role

# Lambda Function for resource cleanup
AWS_LAMBDA_CLEANUP_FUNCTION=qb-migration-staging-cleanup

# AWS Secrets Manager ARN (for storing QBO credentials)
AWS_SECRETS_MANAGER_ARN=arn:aws:secretsmanager:ca-central-1:ACCOUNT_ID:secret:forensicbridge/staging

# ============================================================================
# REDIS / RATE LIMITING
# ============================================================================
# ElastiCache Redis cluster for staging (single-node, encryption in transit)
REDIS_URL=redis://forensicbridge-staging-redis.xxxxx.ca-central-1.cache.amazonaws.com:6379/0

# AUDIT FIX HIGH-18: Redis password (minimum 16 characters)
# Inject from AWS Secrets Manager: forensicbridge/staging/redis-password
REDIS_PASSWORD=INJECT-FROM-SECRETS-MANAGER

# ============================================================================
# RATE LIMITING - Slightly relaxed vs production for QA testing
# ============================================================================
# Production uses stricter limits; staging is relaxed to allow automated
# integration tests and QA load testing without false-positive blocks.
# These values are ~2x production defaults.
#
# Format: "requests per period" (handled by Flask-Limiter)
# Default rate limit: 200/minute (prod: 100/minute)
# Auth endpoints: 20/minute (prod: 10/minute)
# File upload: 40/hour (prod: 20/hour)
# ============================================================================

# ============================================================================
# MONITORING & ALERTING
# ============================================================================
# Sentry DSN - staging project (separate from production)
# Create a dedicated staging project in Sentry to avoid alert noise
SENTRY_DSN=https://INJECT-STAGING-DSN@o123456.ingest.sentry.io/staging-project-id

# Sentry environment tag
SENTRY_ENVIRONMENT=staging

# CloudWatch - staging-specific log groups
CLOUDWATCH_LOG_GROUP=/aws/qb-migration/staging
CLOUDWATCH_LOG_STREAM=app-logs

# Alert email for staging failures (engineering team, not on-call pager)
ALERT_EMAIL=INJECT-FROM-SECRETS-MANAGER

# ============================================================================
# LOGGING
# ============================================================================
# INFO level for staging - captures request/response metadata without
# DEBUG-level verbosity. Sufficient for troubleshooting integration issues.
LOG_LEVEL=INFO
GUNICORN_LOG_LEVEL=info

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# Staging uses SES sandbox or Mailtrap to prevent accidental real emails
MAIL_SERVER=email-smtp.ca-central-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=INJECT-FROM-SECRETS-MANAGER
MAIL_PASSWORD=INJECT-FROM-SECRETS-MANAGER
MAIL_DEFAULT_SENDER=noreply-staging@forensicbridge.ca

# ============================================================================
# QUICKBOOKS ONLINE
# ============================================================================
# QBO sandbox environment for staging (no real financial data)
QBO_CLIENT_ID=INJECT-FROM-SECRETS-MANAGER
QBO_CLIENT_SECRET=INJECT-FROM-SECRETS-MANAGER
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=https://staging-api.forensicbridge.ca/api/qbo/callback

# ============================================================================
# SECURITY SETTINGS - All security features enabled (production parity)
# ============================================================================
# Account lockout policy
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Session management
SESSION_TIMEOUT_HOURS=24

# CAPTCHA enforcement
CAPTCHA_THRESHOLD=3

# reCAPTCHA keys (staging-specific site key)
RECAPTCHA_SITE_KEY=INJECT-FROM-SECRETS-MANAGER
RECAPTCHA_SECRET_KEY=INJECT-FROM-SECRETS-MANAGER

# CSRF protection: enabled (must match production)
CSRF_ENABLED=true

# ============================================================================
# MFA / TWO-FACTOR AUTHENTICATION
# ============================================================================
# MFA enforced in staging to validate the full auth flow before production
MFA_REQUIRED=true

# ============================================================================
# CLEANUP SETTINGS
# ============================================================================
AUTO_CLEANUP_ENABLED=true
CLEANUP_CHECK_INTERVAL_MINUTES=15
ORPHANED_INSTANCE_TIMEOUT_HOURS=6
FORCE_CLEANUP_AFTER_HOURS=48

# ============================================================================
# TIMEOUTS & LIMITS
# ============================================================================
EC2_STARTUP_TIMEOUT_MINUTES=15
MIGRATION_MAX_DURATION_HOURS=8
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=30

# File upload limits (in MB)
MAX_UPLOAD_SIZE_MB=50

# ============================================================================
# COST TRACKING
# ============================================================================
ENABLE_COST_TRACKING=true
S3_COST_PER_GB=0.023
EC2_COST_PER_HOUR=0.0416

# ============================================================================
# DATA RETENTION
# ============================================================================
# Staging uses shorter retention to control costs
MIGRATION_METADATA_RETENTION_DAYS=30
USER_DATA_RETENTION_DAYS=90
S3_FILE_TTL_HOURS=24
BACKUP_RETENTION_DAYS=7

# ============================================================================
# QBEXTRACTOR CONFIGURATION
# ============================================================================
# Path to locally-hosted QBExtractor.exe (leave empty to download from GitHub)
EXTRACTOR_PATH=

# ============================================================================
# INTERNAL API AUTHENTICATION (CRIT-09 FIX)
# ============================================================================
# API key for Lambda and internal service-to-service calls
# Inject from AWS Secrets Manager: forensicbridge/staging/internal-api-key
INTERNAL_API_KEY=INJECT-FROM-SECRETS-MANAGER

# KDF Salt for encryption (HIGH-15 FIX)
# Inject from AWS Secrets Manager: forensicbridge/staging/kdf-salt
QBM_KDF_SALT=INJECT-FROM-SECRETS-MANAGER

# ============================================================================
# FEATURE FLAGS - All enabled in staging for pre-production validation
# ============================================================================
ENABLE_2FA=true
ENABLE_VIRUS_SCANNING=true
ENABLE_BACKUP_TO_S3=true
ENABLE_METRICS_DASHBOARD=true

# ============================================================================
# EC2/STAGING DEPLOYMENT (Gunicorn)
# ============================================================================
# Gunicorn bind address (behind ALB)
GUNICORN_BIND=0.0.0.0:5000

# Workers: fewer than production to save staging costs
# Production uses (2 x CPU cores) + 1; staging uses a fixed count
GUNICORN_WORKERS=3

# Worker class: gevent for async I/O (same as production)
GUNICORN_WORKER_CLASS=gevent

# Worker timeout (seconds) - same as production for parity
GUNICORN_TIMEOUT=120

# Access/Error logs: stdout/stderr for CloudWatch ingestion
GUNICORN_ACCESS_LOG=-
GUNICORN_ERROR_LOG=-

# Max requests before worker restart (memory leak prevention)
GUNICORN_MAX_REQUESTS=1000

# ============================================================================
# ADMIN API
# ============================================================================
# Inject from AWS Secrets Manager: forensicbridge/staging/admin-api-key
ADMIN_API_KEY=INJECT-FROM-SECRETS-MANAGER
