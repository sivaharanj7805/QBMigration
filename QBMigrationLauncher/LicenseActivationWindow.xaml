<Window x:Class="QBMigrationLauncher.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activate License" Height="380" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A">
    
    <Grid Margin="30">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="Activate Your License" FontSize="22" FontWeight="SemiBold" 
                       Foreground="White" Margin="0,0,0,10"/>
            <TextBlock Text="Enter your ForensicBridge license key to activate this machine." 
                       FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,25"/>
            
            <!-- Session ID Input -->
            <!-- FIX #20 & #52: Corrected terminology and MaxLength to match actual format -->
            <TextBlock Text="Session ID" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8"/>
            <TextBox x:Name="LicenseKeyTextBox" Height="45" FontSize="14"
                     Padding="12,10" Background="#334155" Foreground="White"
                     BorderBrush="#475569" BorderThickness="1"
                     CharacterCasing="Upper" MaxLength="26">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <TextBlock Text="Format: FB-YYYYMMDDHHMMSS-XXXXXXXX (e.g., FB-20260128170624-AXO52A38)" FontSize="11"
                       Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap"/>
            
            <!-- Error/Success Message -->
            <TextBlock x:Name="StatusMessage" Text="" FontSize="13" 
                       Margin="0,15,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
            
            <!-- Activate Button -->
            <Button x:Name="ActivateButton" Content="Activate License" Height="50" 
                    FontSize="16" FontWeight="SemiBold" Margin="0,25,0,0"
                    Background="#10B981" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="ActivateButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            
            <!-- Loading -->
            <TextBlock x:Name="LoadingText" Text="Activating..." FontSize="13" 
                       Foreground="#94A3B8" HorizontalAlignment="Center" 
                       Margin="0,15,0,0" Visibility="Collapsed"/>
            
            <!-- Cancel Button -->
            <Button Content="Cancel" Height="40" FontSize="14" Margin="0,15,0,0"
                    Background="Transparent" Foreground="#94A3B8" 
                    BorderBrush="#475569" BorderThickness="1"
                    Cursor="Hand" Click="CancelButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            
            <!-- Purchase Link -->
            <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0">
                <Run Text="Need a license? " Foreground="#94A3B8"/>
                <Hyperlink x:Name="PurchaseLink" Foreground="#3B82F6" 
                           Click="PurchaseLink_Click">Purchase at forensicbridge.ca</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
