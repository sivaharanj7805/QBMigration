<Window x:Class="QBMigrationLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QBMigrationLauncher"
        mc:Ignorable="d"
        Title="QuickBooks Migration Tool - Enterprise Edition" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F5F5F5">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Config -->
            <RowDefinition Height="Auto"/> <!-- Action -->
            <RowDefinition Height="Auto"/> <!-- Progress -->
            <RowDefinition Height="*"/>    <!-- Logs -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,20" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <!-- Logo Placeholder -->
                    <TextBlock Text="Q" FontSize="28" FontWeight="Bold" Foreground="#2CA01C" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="QuickBooks Migration Tool" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#333333"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="{Binding ConnectionStatusColor}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="14" Foreground="#555555" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Configuration -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20" Effect="{DynamicResource ShadowEffect}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#E0E0E0" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Configuration" FontSize="18" FontWeight="Bold" Foreground="#2CA01C" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Company File" FontSize="14" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding DetectedFiles}" SelectedItem="{Binding SelectedFile}" 
                              Height="40" FontSize="14" Padding="10" Background="#F4F8F4" BorderBrush="#2CA01C">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 "/>
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="We auto-detected open QuickBooks files." FontSize="12" Foreground="#888888" Margin="0,5,0,0"/>
                </StackPanel>
                
                <!-- Health Check Button -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Command="{Binding RunHealthCheckCommand}" Width="140" Height="45" 
                            Background="#FF9800" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍 " FontSize="16"/>
                            <TextBlock Text="Health Check" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Pre-flight validation" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Button -->
        <Button Grid.Row="2" Command="{Binding StartMigrationCommand}" IsEnabled="{Binding CanStart}"
                Height="60" Margin="0,0,0,20" Background="Transparent" BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{Binding ButtonColor}" CornerRadius="30" Padding="0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ButtonText}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,10,0"/>
                                <TextBlock Text="↗" FontSize="18" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                             <Setter Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Progress Area -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
             <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#E0E0E0" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="{Binding ProgressPercentage, StringFormat={}{0}%}" FontWeight="Bold" Foreground="White" 
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="1" Margin="5,0,0,25"/>
                    <!-- Custom Progress Bar -->
                     <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="30" Foreground="#2CA01C" Background="#EEEEEE" BorderThickness="0"/>
                </Grid>
                
                <TextBlock Text="{Binding CurrentStatusMessage}" FontSize="14" Foreground="#555555"/>
            </StackPanel>
        </Border>

        <!-- Logs Expander -->
        <Expander Grid.Row="4" Header="Logs" IsExpanded="True" BorderBrush="#DDDDDD">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding LogOutput}" IsReadOnly="True" Background="#FAFAFA" FontFamily="Consolas" BorderThickness="0" Padding="10" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Expander>

    </Grid>
</Window>
