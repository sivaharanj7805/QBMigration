# ============================================================================
# QB MIGRATION SERVER - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git - only commit .env.example
# ============================================================================

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=development
# CFG-02: Default to false to prevent accidental production debug mode
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-THIS-generate-with-python-secrets-module

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=CHANGE-THIS-generate-with-python-secrets-module

# Your server URL (for EC2 instances to call back)
SERVER_URL=http://localhost:5000

# CORS Allowed Origins (comma-separated)
# Both www and non-www variants are automatically added
# Development: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
# Production example:
ALLOWED_ORIGINS=https://forensicbridge.ca

# Backup encryption key - Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=CHANGE-THIS-use-fernet-key-generation

# ============================================================================
# DATABASE - PostgreSQL
# ============================================================================
# Local development
DATABASE_URL=postgresql://username:password@localhost:5432/qbmigration_dev

# Production example (AWS RDS):
# DATABASE_URL=postgresql://username:password@your-rds.amazonaws.com:5432/qbmigration

# ============================================================================
# AWS CONFIGURATION
# ============================================================================
# IMPORTANT: In production, use IAM roles instead of access keys
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# M-20 FIX: Default to ca-central-1 for PIPEDA/Canadian data residency compliance.
# CloudFormation also defaults to ca-central-1.
AWS_REGION=ca-central-1

# S3 Bucket for temporary file storage
AWS_S3_BUCKET=your-bucket-name

# EC2 Configuration
AWS_EC2_AMI_ID=ami-xxxxxxxxxxxxxxxxx
AWS_EC2_INSTANCE_TYPE=t3.medium
AWS_EC2_KEY_NAME=your-key-pair-name
AWS_EC2_SECURITY_GROUP=sg-xxxxxxxxxxxxxxxxx
AWS_EC2_SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx

# IAM Role for EC2 instances
AWS_IAM_INSTANCE_PROFILE=QB-Migration-Instance-Role

# Lambda Function for cleanup
AWS_LAMBDA_CLEANUP_FUNCTION=qb-migration-cleanup

# AWS Secrets Manager ARN (for storing QBO credentials)
AWS_SECRETS_MANAGER_ARN=arn:aws:secretsmanager:ca-central-1:123456789:secret:qb-migration

# ============================================================================
# RATE LIMITING
# ============================================================================
# Use Redis in production for distributed rate limiting
REDIS_URL=memory://
# Production Redis: redis://your-redis-host:6379/0

# AUDIT FIX HIGH-18: Redis password (minimum 16 characters)
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=CHANGE-THIS-use-openssl-rand-base64-24

# ============================================================================
# MONITORING & ALERTING
# ============================================================================
# Sentry (get free account at sentry.io)
SENTRY_DSN=

# CloudWatch
CLOUDWATCH_LOG_GROUP=/aws/qb-migration
CLOUDWATCH_LOG_STREAM=app-logs

# Alert email for critical failures
ALERT_EMAIL=admin@yourcompany.com

# ============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@yourcompany.com

# ============================================================================
# QUICKBOOKS ONLINE
# ============================================================================
# Get from Intuit Developer Portal
QBO_CLIENT_ID=your-client-id
QBO_CLIENT_SECRET=your-client-secret
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=http://localhost:5000/api/qbo/callback

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
# Max login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes
ACCOUNT_LOCKOUT_MINUTES=15

# Session timeout in hours
SESSION_TIMEOUT_HOURS=24

# Require CAPTCHA after failed attempts
CAPTCHA_THRESHOLD=3

# reCAPTCHA keys (get from google.com/recaptcha)
RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# ============================================================================
# CLEANUP SETTINGS
# ============================================================================
AUTO_CLEANUP_ENABLED=true
CLEANUP_CHECK_INTERVAL_MINUTES=15
ORPHANED_INSTANCE_TIMEOUT_HOURS=6
FORCE_CLEANUP_AFTER_HOURS=48

# ============================================================================
# TIMEOUTS & LIMITS
# ============================================================================
EC2_STARTUP_TIMEOUT_MINUTES=15
MIGRATION_MAX_DURATION_HOURS=8
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=30

# File upload limits (in MB)
MAX_UPLOAD_SIZE_MB=50

# ============================================================================
# COST TRACKING
# ============================================================================
# Enable AWS Cost Explorer integration
ENABLE_COST_TRACKING=true

# Cost per GB for S3 storage (for estimation)
S3_COST_PER_GB=0.023

# Cost per hour for EC2 instance (for estimation)
EC2_COST_PER_HOUR=0.0416

# ============================================================================
# DATA RETENTION
# ============================================================================
MIGRATION_METADATA_RETENTION_DAYS=90
USER_DATA_RETENTION_DAYS=365
S3_FILE_TTL_HOURS=24
BACKUP_RETENTION_DAYS=7

# ============================================================================
# QBEXTRACTOR CONFIGURATION
# ============================================================================
# Path to locally-hosted QBExtractor.exe (optional)
# If set, the server will serve this file instead of downloading from GitHub
# Common paths:
#   - /var/www/forensicbridge/extractor/QBExtractor.exe (production)
#   - /opt/forensicbridge/extractor/QBExtractor.exe (alternative)
#   - ./static/extractor/QBExtractor.exe (development)
EXTRACTOR_PATH=

# ============================================================================
# INTERNAL API AUTHENTICATION (CRIT-09 FIX)
# ============================================================================
# API key for Lambda and internal service-to-service calls
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=CHANGE-THIS-generate-with-python-secrets-module

# KDF Salt for encryption (HIGH-15 FIX)
# Generate with: python -c "import os; print(os.urandom(32).hex())"
QBM_KDF_SALT=

# QBMigrationService path (CRIT-06 FIX)
# Only set if not using default relative path
# QBM_SERVICE_PATH=/path/to/QBMigrationService

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_2FA=false
ENABLE_VIRUS_SCANNING=false
ENABLE_BACKUP_TO_S3=true
ENABLE_METRICS_DASHBOARD=false

# ============================================================================
# EC2/PRODUCTION DEPLOYMENT (Gunicorn)
# ============================================================================
# Gunicorn bind address (0.0.0.0:5000 for EC2 behind ALB)
GUNICORN_BIND=0.0.0.0:5000

# Workers = (2 x CPU cores) + 1 (auto-calculated if not set)
# GUNICORN_WORKERS=5

# Worker class: gthread (threaded workers, matches Dockerfile default), sync, or gevent
GUNICORN_WORKER_CLASS=gthread

# Worker timeout (seconds) - set high enough for file uploads
GUNICORN_TIMEOUT=120

# Log level: debug, info, warning, error, critical
GUNICORN_LOG_LEVEL=info

# Access/Error logs: '-' for stdout/stderr, or file path
GUNICORN_ACCESS_LOG=-
GUNICORN_ERROR_LOG=-

# Max requests before worker restart (memory leak prevention)
GUNICORN_MAX_REQUESTS=1000

# ============================================================================
# ADMIN API (for health endpoint authentication)
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=CHANGE-THIS-generate-with-python-secrets-module