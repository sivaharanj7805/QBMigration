<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>

    <!-- Application settings -->
    <AssemblyName>ForensicBridge</AssemblyName>
    <RootNamespace>ForensicBridgeInstaller</RootNamespace>
    <Version>2.0.0</Version>
    <Description>ForensicBridge QuickBooks Desktop Migration Tool</Description>
    <Company>ForensicBridge Inc.</Company>
    <Product>ForensicBridge</Product>

    <!-- Windows Forms -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Enable nullable types -->
    <Nullable>enable</Nullable>

    <!-- Self-contained for distribution -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Application icon -->
    <ApplicationIcon Condition="Exists('icon.ico')">icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Copy config files to output -->
  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
