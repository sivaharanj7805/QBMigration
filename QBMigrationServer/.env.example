# ── Database ─────────────────────────────────────────────────────────────────
# Defaults to SQLite for local dev. For production, uncomment and set:
# DATABASE_URL=postgresql://qbmigration:<password>@<rds-endpoint>:5432/qbmigration

# ── Redis (required for rate limiting + realm locking) ───────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS Configuration (PIPEDA: must be Canadian region) ──────────────────────
AWS_REGION=ca-central-1
AWS_S3_BUCKET=CHANGE_ME_S3_BUCKET_NAME
AWS_S3_CODE_BUCKET=CHANGE_ME_S3_CODE_BUCKET
AWS_EC2_AMI_ID=CHANGE_ME_AMI_ID
AWS_EC2_INSTANCE_TYPE=t3.micro
AWS_EC2_KEY_NAME=CHANGE_ME_KEY_PAIR_NAME
AWS_EC2_SECURITY_GROUP=CHANGE_ME_SG_ID
AWS_EC2_SUBNET_ID=CHANGE_ME_SUBNET_ID
AWS_IAM_INSTANCE_PROFILE=QB-Migration-Instance-Role
# NOTE: Prefer IAM roles over access keys. Only set these if IAM roles are not available:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ALLOW_AWS_KEYS=true

# ── QuickBooks Online OAuth ──────────────────────────────────────────────────
QBO_CLIENT_ID=CHANGE_ME_FROM_INTUIT_DEVELOPER_PORTAL
QBO_CLIENT_SECRET=CHANGE_ME_FROM_INTUIT_DEVELOPER_PORTAL
QBO_ENVIRONMENT=production
QBO_REDIRECT_URI=https://CHANGE_ME_YOUR_DOMAIN/api/qbo/callback

# ── CORS & URLs ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://CHANGE_ME_YOUR_FRONTEND_DOMAIN
SERVER_URL=https://CHANGE_ME_YOUR_API_DOMAIN
FRONTEND_URL=https://CHANGE_ME_YOUR_FRONTEND_DOMAIN

# ── Email (AWS SES) ─────────────────────────────────────────────────────────
MAIL_SERVER=email-smtp.ca-central-1.amazonaws.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=CHANGE_ME_SES_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SES_SMTP_PASSWORD
MAIL_DEFAULT_SENDER=noreply@CHANGE_ME_YOUR_DOMAIN
ALERT_EMAIL=admin@CHANGE_ME_YOUR_DOMAIN

# ── Stripe Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET

# ── Monitoring ───────────────────────────────────────────────────────────────
# Uncomment and set when you have a Sentry account:
# SENTRY_DSN=https://key@o123456.ingest.sentry.io/12345

# ── Gunicorn ─────────────────────────────────────────────────────────────────
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_WORKERS=5
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# ── Optional Feature Flags (defaults shown) ──────────────────────────────────
# ENABLE_2FA=true
# ENABLE_BACKUP_TO_S3=true
# ENABLE_WEBHOOK_LOGGING=true
# ENABLE_COST_TRACKING=true
# AUTO_CLEANUP_ENABLED=true
# MAX_UPLOAD_SIZE_MB=50
# SESSION_TIMEOUT_HOURS=24
