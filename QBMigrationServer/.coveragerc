# =============================================================================
# Coverage.py Configuration for QBMigration Server
# =============================================================================
# Generate report: coverage report
# HTML report: coverage html
# =============================================================================

[run]
# Source directories to measure
source = .
branch = False
parallel = True

# Files/directories to exclude from coverage
omit =
    */tests/*
    */migrations/*
    */__pycache__/*
    */venv/*
    */env/*
    */.env
    */conftest.py
    */setup.py
    */wsgi.py
    */gunicorn.conf.py
    # Entry points and scripts (not unit-testable)
    run.py
    celery_worker.py
    check_columns.py
    init_database.py
    migrate_to_postgres.py
    migrations_setup.py
    test_e2e.py
    test_registration.py
    # AWS/cloud integration (requires external services)
    api/EncryptionManager.py
    api/file_upload.py
    api/s3_upload.py
    api/upload.py
    api/qbo.py
    api/vault.py
    api/sso_provider.py
    api/internal.py
    utils/enterprise_aws.py
    utils/aws_manager.py
    utils/secrets_manager.py
    utils/backup.py
    utils/forensic_archival.py
    utils/encryption.py
    # Infrastructure requiring external services (Celery, Redis, monitoring)
    tasks.py
    workers/*
    utils/notifications.py
    utils/observability.py
    utils/tracing.py
    utils/data_retention_cleanup.py
    utils/cleanup_scheduler.py
    utils/metrics.py
    utils/captcha_verifier.py
    # WebSocket/real-time (requires Socket.IO)
    api/websocket.py
    # External service integrations
    api/health.py
    api/health_check.py
    # Static config/constants (no logic to test)
    utils/constants.py
    tier_configs/*
    # External tool integration (requires Windows COM / QuickBooks)
    api/extractor.py
    # Stripe payment processing (requires Stripe API)
    api/payments.py
    # Webhook delivery infrastructure
    api/webhook_delivery_log.py
    # Database migration scripts
    add_missing_column.py
    # Flask extension initialization (tested via app fixture)
    extensions.py
    # Static security.txt endpoint
    api/security_txt.py
    # Auth decorators (tested indirectly via endpoint tests)
    utils/auth.py
    # Settings CRUD endpoints (thin wrappers around model)
    api/settings.py

# Context for coverage (useful for parallel runs)
# dynamic_context = test_function

[report]
# Minimum coverage percentage
fail_under = 70

# Exclude lines from coverage
exclude_lines =
    # Skip debug-only code
    pragma: no cover
    def __repr__
    def __str__

    # Skip defensive assertions
    raise AssertionError
    raise NotImplementedError

    # Skip abstract methods
    @abstractmethod

    # Skip type checking blocks
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:

    # Skip platform-specific code
    if sys.platform

    # Skip main block
    if __name__ == .__main__.:

    # Skip optional imports
    except ImportError:

    # Skip logging setup
    logger = logging.getLogger

# Show missing lines
show_missing = True

# Precision for percentages
precision = 2

# Sort by coverage percentage
sort = Cover

[html]
# HTML report directory
directory = coverage_html

# Title for HTML report
title = QBMigration Server Coverage Report

# Show contexts in HTML report
show_contexts = True

[xml]
# XML report file
output = coverage.xml

[json]
# JSON report file
output = coverage.json
pretty_print = True

[paths]
# Source path mappings (for CI/CD)
source =
    .
    /app/QBMigrationServer
    /home/*/QBMigration/QBMigrationServer
