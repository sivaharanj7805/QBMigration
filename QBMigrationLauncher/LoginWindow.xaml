<Window x:Class="QBMigrationLauncher.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ForensicBridge - Sign In" Height="550" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0F172A">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header / Logo -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,40,0,30">
            <TextBlock Text="FORENSICBRIDGE" FontSize="28" FontWeight="Bold" 
                       Foreground="#3B82F6" HorizontalAlignment="Center"/>
            <TextBlock Text="Cryptographic Migration Suite" FontSize="14" 
                       Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Login Form -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" 
                Margin="30,0,30,0" Padding="30" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Sign In" FontSize="22" FontWeight="SemiBold" 
                           Foreground="White" Margin="0,0,0,25"/>
                
                <!-- Email Field -->
                <TextBlock Text="Email Address" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8"/>
                <TextBox x:Name="EmailTextBox" Height="45" FontSize="14" 
                         Padding="12,10" Background="#334155" Foreground="White"
                         BorderBrush="#475569" BorderThickness="1">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                
                <!-- Password Field -->
                <TextBlock Text="Password" FontSize="13" Foreground="#94A3B8" Margin="0,20,0,8"/>
                <PasswordBox x:Name="PasswordBox" Height="45" FontSize="14" 
                             Padding="12,10" Background="#334155" Foreground="White"
                             BorderBrush="#475569" BorderThickness="1">
                    <PasswordBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>
                
                <!-- Error Message -->
                <TextBlock x:Name="ErrorMessage" Text="" FontSize="13" 
                           Foreground="#EF4444" Margin="0,15,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
                
                <!-- Sign In Button -->
                <Button x:Name="SignInButton" Content="Sign In" Height="50" 
                        FontSize="16" FontWeight="SemiBold" Margin="0,25,0,0"
                        Background="#3B82F6" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="SignInButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <!-- Loading Indicator -->
                <TextBlock x:Name="LoadingText" Text="Signing in..." FontSize="13" 
                           Foreground="#94A3B8" HorizontalAlignment="Center" 
                           Margin="0,15,0,0" Visibility="Collapsed"/>
                
                <!-- Divider -->
                <Grid Margin="0,25,0,25">
                    <Rectangle Height="1" Fill="#475569"/>
                    <TextBlock Text="OR" FontSize="12" Foreground="#64748B" 
                               Background="#1E293B" HorizontalAlignment="Center" 
                               Padding="10,0"/>
                </Grid>
                
                <!-- Activate License Button -->
                <Button x:Name="ActivateLicenseButton" Content="Activate License Key" 
                        Height="45" FontSize="14" Background="Transparent" 
                        Foreground="#3B82F6" BorderBrush="#3B82F6" BorderThickness="1"
                        Cursor="Hand" Click="ActivateLicenseButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <!-- FIX #18: Register Link - now keyboard accessible using Hyperlink -->
                <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="13">
                    <Run Text="Don't have an account? " Foreground="#94A3B8"/>
                    <Hyperlink x:Name="RegisterLink" Foreground="#3B82F6" Click="RegisterLink_Click"
                               FocusVisualStyle="{x:Null}">Register</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
        
        <!-- Footer -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,30">
            <TextBlock Text="© 2026 ForensicBridge Inc." FontSize="12" Foreground="#64748B"/>
            <TextBlock x:Name="VersionText" Text="Version 4.3" FontSize="11" 
                       Foreground="#475569" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
