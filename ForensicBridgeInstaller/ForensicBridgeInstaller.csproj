<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <LangVersion>9.0</LangVersion>

    <!-- Application settings -->
    <AssemblyName>ForensicBridge</AssemblyName>
    <RootNamespace>ForensicBridgeInstaller</RootNamespace>
    <Version>2.1.0</Version>
    <Description>ForensicBridge QuickBooks Desktop Migration Launcher</Description>
    <Company>ForensicBridge Inc.</Company>
    <Product>ForensicBridge</Product>

    <!-- Windows Forms -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Enable nullable types -->
    <Nullable>enable</Nullable>

    <!-- Application icon -->
    <ApplicationIcon Condition="Exists('icon.ico')">icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Framework assembly references (net48) -->
  <ItemGroup>
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- Copy config files to output -->
  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
