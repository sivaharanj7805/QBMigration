<Window x:Class="QBMigrationLauncher.BulkMigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Migration Manager - Enterprise Edition" Height="700" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">

    <!-- FIX #1: Add missing BooleanToVisibilityConverter resource -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,20" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦" FontSize="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="ForensicBridge Bulk Manager" FontSize="20" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBlock Text="Queue and process multiple QuickBooks files" FontSize="12" Foreground="#888888"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Queued: " Foreground="#888"/>
                    <TextBlock Text="{Binding QueuedCount}" FontWeight="Bold" Foreground="#FF9800"/>
                    <TextBlock Text="  |  Completed: " Foreground="#888"/>
                    <TextBlock Text="{Binding CompletedCount}" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="  |  Failed: " Foreground="#888"/>
                    <TextBlock Text="{Binding FailedCount}" FontWeight="Bold" Foreground="#D32F2F"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="➕ Add Files" Width="120" Height="40" Margin="0,0,10,0" 
                    Command="{Binding AddFilesCommand}" Background="#3B82F6" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="▶️ Start Queue" Width="120" Height="40" Margin="0,0,10,0" 
                    Command="{Binding StartQueueCommand}" Background="#1976D2" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="⏹️ Stop" Width="100" Height="40" Margin="0,0,10,0" 
                    Command="{Binding StopQueueCommand}" Background="#757575" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="🗑️ Clear" Width="100" Height="40" 
                    Command="{Binding ClearQueueCommand}" Background="#D32F2F" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <!-- Job Queue List -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#E0E0E0" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Migration Queue" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                
                <ListView Grid.Row="1" ItemsSource="{Binding AllJobs}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Status" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusIcon}" FontSize="20" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="ID" Width="80" DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="File Name" Width="250" DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="Queued At" Width="150" DisplayMemberBinding="{Binding QueuedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                            <GridViewColumn Header="Duration" Width="100" DisplayMemberBinding="{Binding DurationText}"/>
                            <GridViewColumn Header="Error" Width="200" DisplayMemberBinding="{Binding ErrorMessage}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <!-- Current Job Progress -->
        <Border Grid.Row="3" Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,15,0,15" 
                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Currently Processing:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding CurrentJobName}" FontSize="16"/>
                <ProgressBar Height="20" IsIndeterminate="True" Foreground="#1976D2" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Log Output -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#E0E0E0" Opacity="0.5"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox Text="{Binding LogOutput}" IsReadOnly="True" Background="Transparent" 
                         FontFamily="Consolas" BorderThickness="0" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
